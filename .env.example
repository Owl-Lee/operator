# Copy to .env and fill in what you have. Every integration is optional; features hide when a key is missing.

# Brightspace → Calendar → Subscribe → All Calendars and Tasks. PRIVATE token — never commit it.
BRIGHTSPACE_ICAL_URL=

# Google AI Studio key: understanding text / photos / voice, answering questions
GEMINI_API_KEY=
# Optional: preferred model (falls back automatically on 404 / 429 / 503)
# GEMINI_MODEL=gemini-3.8-flash

# Photon Spectrum project (app.photon.codes). Your phone in E.164, e.g. +16315550123
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
MY_PHONE=+1

# ElevenLabs: spoken briefing, read-aloud, voice call
ELEVENLABS_API_KEY=
# Optional: a different voice
# ELEVENLABS_VOICE_ID=

# Path to ffmpeg if it is not on PATH (voice notes are transcoded before Gemini / iMessage)
# FFMPEG=/usr/bin/ffmpeg

# Minutes between Brightspace polls (default 10)
# POLL_MINUTES=10

# Dashboard port (default 4242)
# PORT=4242

# Optional: pretend "now" is this time, for demos
# FAKE_NOW=2026-10-23T20:00:00-04:00
